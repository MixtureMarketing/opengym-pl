# Konfiguracja openGym — skopiuj do .env i dostosuj:  cp .env.example .env

# Nazwa hosta, do której przypięte są klucze dostępu (passkey). Bez schematu i portu.
# Lokalnie: localhost. Na serwerze: twoja domena, np. silownia.example.pl
RP_ID=localhost

# Pełny adres, pod którym serwowana jest aplikacja (schemat + host + ewentualny port).
# Musi zgadzać się z tym, co widzi przeglądarka — inaczej logowanie kluczem nie zadziała.
ORIGIN=http://localhost:8080

# Port na hoście, pod którym wystawiony jest interfejs webowy.
WEB_PORT=8080

# Nazwa pokazywana w oknie logowania kluczem dostępu.
RP_NAME=openGym

# Identyfikatory użytkowników z dostępem do panelu administratora (po przecinku).
# Zostaw puste przy pierwszym uruchomieniu, potem wpisz swoje id i zrestartuj kontener api.
ADMIN_UIDS=

# 1 = założenie profilu wymaga kodu zaproszenia (kody generujesz w panelu administratora).
INVITE_ONLY=

# Ile dni ważna jest sesja (ciasteczko). Domyślnie 30.
SESSION_DAYS=30

# Adres kontaktowy dla powiadomień push (mailto:). Opcjonalne.
VAPID_SUBJECT=

# Obrazy Dockera używane przez docker-compose. Puste = obrazy z repozytorium autora.
# Po pierwszym przebiegu workflow „Obrazy Dockera (GHCR)" możesz wskazać własne:
#   OPENGYM_API_IMAGE=ghcr.io/twoj-login/opengym-api:latest
#   OPENGYM_WEB_IMAGE=ghcr.io/twoj-login/opengym-web:latest
OPENGYM_API_IMAGE=
OPENGYM_WEB_IMAGE=

# --- Trener AI (opcjonalny) ---
# Bez klucza aplikacja zostaje przy analizie liczonej w przeglądarce (skoki ciężaru,
# zastoje, objętość) — działa offline i nic nie kosztuje. Klucz włącza dodatkowo
# przycisk „Zapytaj trenera": podsumowanie ostatnich tygodni idzie do modelu Claude,
# a odpowiedź wraca do aplikacji. Klucz nigdy nie opuszcza serwera.
# Klucz wygenerujesz na https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model. Domyślnie claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Limit pytań na użytkownika na dobę — zabezpieczenie rachunku. Domyślnie 40.
COACH_DAILY_LIMIT=40
