# openGym w jednym kontenerze: API (Node) serwuje też zbudowany frontend.
# Jeden port, jeden origin — tego wymaga logowanie kluczem dostępu (WebAuthn),
# i tyle właśnie wystawiają platformy typu Render / Railway / Fly.io.
#
# Obrazki i GIF-y ćwiczeń idą z CDN (~140 MB nie ląduje w obrazie).
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci 2>/dev/null || npm install
COPY frontend/ ./
ENV VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
ENV VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY api/package.json api/package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force
COPY api/server.js ./
COPY --from=build /app/dist ./public
ENV NODE_ENV=production \
    STATIC_DIR=/app/public \
    DATA_DIR=/data \
    PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
