# Zależności i wyniki budowania
node_modules/
frontend/dist/
frontend/.vite/

# Konfiguracja lokalna — zawiera dane twojej instancji, NIE commituj
.env
.env.local

# Dane użytkowników: profile, klucze publiczne, treningi, sekret sesji.
